{
  "name": "lectoria",
  "version": "0.1.0",
  "description": "Turn learning documents into reliable multilingual lesson and podcast audio with Azure.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./script": {
      "types": "./dist/script/index.d.ts",
      "import": "./dist/script/index.js"
    },
    "./synthesize": {
      "types": "./dist/synthesize/index.d.ts",
      "import": "./dist/synthesize/index.js"
    },
    "./package": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js"
    },
    "./distribute": {
      "types": "./dist/distribute/index.d.ts",
      "import": "./dist/distribute/index.js"
    },
    "./parse": {
      "types": "./dist/parse/index.d.ts",
      "import": "./dist/parse/index.js"
    },
    "./ingest": {
      "types": "./dist/ingest/index.d.ts",
      "import": "./dist/ingest/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./factory": {
      "types": "./dist/factory.d.ts",
      "import": "./dist/factory.js"
    },
    "./estimate": {
      "types": "./dist/estimate.d.ts",
      "import": "./dist/estimate.js"
    }
  },
  "bin": {
    "lectoria": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src scripts/*.mjs eslint.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/package-smoke.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "validate": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:package && npm run audit:prod",
    "clean": "rimraf dist out/*.mp3 out/*.xml",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "keywords": [
    "podcast",
    "tts",
    "azure",
    "azure-openai",
    "azure-speech",
    "documents",
    "learning",
    "multilingual",
    "spanish",
    "english",
    "notebooklm",
    "audiobook",
    "narration"
  ],
  "author": "@senrique_microsoft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RubenSaucedo/lectoria.git"
  },
  "bugs": {
    "url": "https://github.com/RubenSaucedo/lectoria/issues"
  },
  "homepage": "https://github.com/RubenSaucedo/lectoria#readme",
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@mozilla/readability": "^0.6.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "jsdom": "^30.0.1",
    "mammoth": "^1.8.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "node-id3": "^0.2.6",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "podcast": "^2.0.1",
    "proper-lockfile": "^4.1.2",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.1.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
