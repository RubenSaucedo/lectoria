# ────────────────────────────────────────────────────────────────
# lectoria — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ────────────────────────────────────────────────────────────────

# ── Auth: Microsoft Entra ID (no keys!) ────────────────────────
# Sign in once on this box:
#     az login
# Then assign yourself these RBAC roles on the resources below:
#   - Azure Speech:  "Cognitive Services User"   (or "Cognitive Services Speech User")
#   - Azure OpenAI:  "Cognitive Services OpenAI User"
# The SDK's DefaultAzureCredential picks up your CLI login automatically.

# ── Azure AI Speech (TTS) ──────────────────────────────────────
AZURE_SPEECH_REGION=eastus
# Full Azure resource ID of your Speech resource. Find it with:
#   az cognitiveservices account show -n <name> -g <rg> --query id -o tsv
# Example:
# /subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/lectoria-rg/providers/Microsoft.CognitiveServices/accounts/lectoria-speech
AZURE_SPEECH_RESOURCE_ID=

# Voice preset — bundles host/guest voices + pace per language.
# One of: espana (default, warm Castilian) | latino | intermedio.
# Run `lectoria voices` to see them. See the README "Voices" section.
LECTORIA_VOICE_PRESET=espana

# Optional: override a single voice slot (a bare Azure voice id). Leave these
# commented so the preset above wins; uncomment to pin a specific voice.
# https://learn.microsoft.com/azure/ai-services/speech-service/language-support
# LECTORIA_VOICE_EN=en-US-AndrewMultilingualNeural
# LECTORIA_VOICE_ES=es-ES-AlvaroNeural
# Second voice used by `--style dialogue` (NotebookLM-style two-host exchange).
# LECTORIA_VOICE_EN_GUEST=en-US-BrianMultilingualNeural
# LECTORIA_VOICE_ES_GUEST=es-ES-DarioNeural

# ── Azure OpenAI (scripting + translation) ─────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── Pipeline defaults ──────────────────────────────────────────
# Comma-separated list of target languages.
LECTORIA_TARGET_LANGS=en,es

# Output directory for MP3 + RSS.
LECTORIA_OUT_DIR=./out

# Podcast feed metadata (used by RSS generator).
# RSS is generated only when this public root URL is configured. It must map
# to the directory where you publish LECTORIA_OUT_DIR.
# LECTORIA_AUDIO_BASE_URL=https://cdn.example.com/lectoria
LECTORIA_FEED_TITLE=Lectoria
LECTORIA_FEED_DESCRIPTION=Written learning content, narrated.
LECTORIA_FEED_AUTHOR=
LECTORIA_FEED_SITE_URL=https://example.com
LECTORIA_FEED_IMAGE_URL=https://example.com/cover.jpg

# ── Glossary (optional) ────────────────────────────────────────
# Path to a JSON file listing project-specific terms (brand names,
# acronyms, code identifiers) that should keep English pronunciation
# even when narrated in another language. Shape:
#   { "terms": ["MCP", "HubSpot", { "term": "DA", "meaning": "Domain Admin" }] }
# See README → "Glossaries: English pronunciation across translations".
# LECTORIA_GLOSSARY_FILE=./glossary.json

# ── OneDrive ingest (v1, not yet wired) ────────────────────────
# ONEDRIVE_TENANT_ID=
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_FOLDER_PATH=/Documents/Lectoria
