{
  "name": "lectoria",
  "version": "0.0.1",
  "description": "Turn written learning content into multilingual podcast audio (EN + ES to start).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./script": {
      "types": "./dist/script/index.d.ts",
      "import": "./dist/script/index.js"
    },
    "./synthesize": {
      "types": "./dist/synthesize/index.d.ts",
      "import": "./dist/synthesize/index.js"
    },
    "./package": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js"
    },
    "./distribute": {
      "types": "./dist/distribute/index.d.ts",
      "import": "./dist/distribute/index.js"
    },
    "./parse": {
      "types": "./dist/parse/index.d.ts",
      "import": "./dist/parse/index.js"
    },
    "./ingest": {
      "types": "./dist/ingest/index.d.ts",
      "import": "./dist/ingest/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./factory": {
      "types": "./dist/factory.d.ts",
      "import": "./dist/factory.js"
    },
    "./estimate": {
      "types": "./dist/estimate.d.ts",
      "import": "./dist/estimate.js"
    }
  },
  "bin": {
    "lectoria": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist out/*.mp3 out/*.xml",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "podcast",
    "tts",
    "azure",
    "azure-openai",
    "azure-speech",
    "documents",
    "learning",
    "multilingual",
    "spanish",
    "english",
    "notebooklm",
    "audiobook",
    "narration"
  ],
  "author": "@senrique_microsoft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RubenSaucedo/lectoria.git"
  },
  "bugs": {
    "url": "https://github.com/RubenSaucedo/lectoria/issues"
  },
  "homepage": "https://github.com/RubenSaucedo/lectoria#readme",
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@mozilla/readability": "^0.5.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "jsdom": "^25.0.1",
    "mammoth": "^1.8.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.40.0",
    "node-id3": "^0.2.6",
    "openai": "^4.67.0",
    "pdf-parse": "^1.1.1",
    "podcast": "^2.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.7.4",
    "@types/pdf-parse": "^1.1.4",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
